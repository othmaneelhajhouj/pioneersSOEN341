<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<title>Events</title>
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<!-- Include navigation bar -->
	<%- include('../partials/nav', { active: 'events', injectStyles: true }) %>
</head>
<body>
<!-- Hero section with page title -->
<%- include('../partials/hero', { title: 'Upcoming Events', subtitle: 'Claim tickets & stay engaged.' }) %>

<main class="container pb-5">
  <%
    // Get filter data from controller (if it exists)
    const metaData = typeof meta !== 'undefined' ? meta : {filters: {}};
    const filters = metaData.filters || {};
    const hasError = typeof loadError !== 'undefined' ? loadError : false;
    
    // Helper function to convert date to YYYY-MM-DD format for input fields
    const dateToInput = (d) => {
      if (!d) return '';
      try {
        const iso = new Date(d).toISOString();
        return iso.split('T')[0]; // Get just the date part
      } catch (_e) {
        return '';
      }
    };
    
    // Get current sort and order values (defaults)
    const sortValue = metaData.sort || 'startsAt';
    const orderValue = metaData.order || 'asc';
  %>
  
  <!-- Filter and Sort Form -->
  <section class="card bg-dark border-secondary shadow-sm mb-4">
    <form class="card-body row gy-3 align-items-end" method="get" action="/events">
      <!-- Search by title or description -->
      <div class="col-12 col-md-4">
        <label class="form-label small text-uppercase text-secondary" for="search">Search</label>
        <input type="search" class="form-control form-control-sm" id="search" name="search" 
               placeholder="e.g. Career Fair, Workshop..." value="<%= filters.search || '' %>">
      </div>
      
      <!-- Filter by date range -->
      <div class="col-6 col-md-3">
        <label class="form-label small text-uppercase text-secondary" for="from">From</label>
        <input type="date" class="form-control form-control-sm" id="from" name="from" 
               value="<%= dateToInput(filters.from) %>">
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small text-uppercase text-secondary" for="to">To</label>
        <input type="date" class="form-control form-control-sm" id="to" name="to" 
               value="<%= dateToInput(filters.to) %>">
      </div>
      
      <!-- Filter by category -->
      <div class="col-6 col-md-2">
        <label class="form-label small text-uppercase text-secondary" for="category">Category</label>
        <input type="text" class="form-control form-control-sm" id="category" name="category" 
               placeholder="e.g. Career" value="<%= filters.category || '' %>">
      </div>
      
      <!-- Filter by organization ID -->
      <div class="col-6 col-md-2">
        <label class="form-label small text-uppercase text-secondary" for="org">Organization</label>
        <input type="text" class="form-control form-control-sm" id="org" name="org" 
               placeholder="Org ID" value="<%= filters.org || '' %>">
      </div>
      
      <!-- Sort options -->
      <div class="col-6 col-md-2">
        <label class="form-label small text-uppercase text-secondary" for="sort">Sort by</label>
        <select id="sort" name="sort" class="form-select form-select-sm">
          <option value="startsAt" <%= sortValue === 'startsAt' ? 'selected' : '' %>>Start date</option>
          <option value="createdAt" <%= sortValue === 'createdAt' ? 'selected' : '' %>>Created date</option>
          <option value="title" <%= sortValue === 'title' ? 'selected' : '' %>>Title</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small text-uppercase text-secondary" for="order">Order</label>
        <select id="order" name="order" class="form-select form-select-sm">
          <option value="asc" <%= orderValue === 'asc' ? 'selected' : '' %>>Ascending</option>
          <option value="desc" <%= orderValue === 'desc' ? 'selected' : '' %>>Descending</option>
        </select>
      </div>
      
      <!-- Apply and Reset buttons -->
      <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="fa-solid fa-filter me-1"></i>Apply</button>
        <a href="/events" class="btn btn-outline-light btn-sm w-100"><i class="fa-solid fa-xmark me-1"></i>Clear</a>
      </div>
    </form>
  </section>
  
  <!-- Active filters summary -->
  <% 
    const hasActiveFilters = filters.search || filters.from || filters.to || filters.category || filters.org;
  %>
  <% if (hasActiveFilters) { %>
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
      <span class="small text-secondary">Active filters:</span>
      <% if (filters.search) { %>
        <span class="badge bg-secondary">Search: <%= filters.search %></span>
      <% } %>
      <% if (filters.from || filters.to) { %>
        <span class="badge bg-secondary">Date: <%= filters.from || '...' %> to <%= filters.to || '...' %></span>
      <% } %>
      <% if (filters.category) { %>
        <span class="badge bg-secondary">Category: <%= filters.category %></span>
      <% } %>
      <% if (filters.org) { %>
        <span class="badge bg-secondary">Org: <%= filters.org %></span>
      <% } %>
    </div>
  <% } %>
  
  <!-- Error message if events failed to load -->
  <% if (hasError) { %>
    <div class="alert alert-danger">We had trouble loading events. Please try again in a moment.</div>
  <% } %>
  
  <!-- Event count badge -->
  <% if (events && events.length > 0) { %>
    <div class="mb-3">
      <span class="badge bg-secondary"><%= events.length %> event<%= events.length !== 1 ? 's' : '' %> found</span>
    </div>
  <% } %>
  
  <!-- Event Cards Grid -->
	<div class="row g-4">
    <% 
    // Loop through each event and display it as a card
    (events || []).forEach(ev => {
      // Format the start date nicely
      const startDate = ev.startsAt ? new Date(ev.startsAt) : null;
      const displayDate = startDate 
        ? startDate.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) 
        : 'Date TBD';
      
      // Calculate relative time
      let relativeTime = '';
      if (startDate) {
        const now = new Date();
        const endDate = ev.endsAt ? new Date(ev.endsAt) : null;
        const diffMs = startDate - now;
        const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
        const diffDays = Math.floor(diffHours / 24);
        
        // Check if event has ended
        if (endDate && endDate < now) {
          relativeTime = 'Ended';
        } else if (diffMs < 0) {
          relativeTime = 'In progress';
        } else if (diffHours < 1) {
          relativeTime = 'Starting soon';
        } else if (diffHours < 24) {
          relativeTime = `In ${diffHours} hour${diffHours !== 1 ? 's' : ''}`;
        } else if (diffDays < 7) {
          relativeTime = `In ${diffDays} day${diffDays !== 1 ? 's' : ''}`;
        }
      }
    %>
			<div class="col-12 col-sm-6 col-lg-4">
				<div class="card h-100">
					<div class="card-body d-flex flex-column">
            <!-- Event title and category -->
            <div class="d-flex justify-content-between align-items-start mb-2">
						  <h5 class="card-title mb-0"><%= ev.title %></h5>
              <% if (ev.category) { %>
                <span class="badge bg-secondary ms-2" style="font-size:10px;"><%= ev.category %></span>
              <% } %>
            </div>
            
            <!-- Event date with icon -->
            <div class="small text-secondary mb-2">
              <i class="fa fa-calendar me-1"></i><%= displayDate %>
              <% if (relativeTime) { %>
                <span class="badge bg-secondary ms-2" style="font-size:9px;"><%= relativeTime %></span>
              <% } %>
            </div>
            
            <!-- Event description (shortened) -->
						<p class="card-text small flex-grow-1"><%= (ev.description || '').slice(0,140) %>...</p>
            
            <%
              // Calculate remaining tickets
              const claimedCount = ev._count ? ev._count.tickets : 0;
              const capacity = Number.isFinite(ev.capacity) ? ev.capacity : 0;
              const remaining = Math.max(capacity - claimedCount, 0);
              const soldOut = capacity !== 0 && remaining <= 0;
              const utilization = capacity > 0 ? Math.round((claimedCount / capacity) * 100) : 0;
            %>
            
            <!-- Capacity indicator -->
            <% if (capacity > 0) { %>
              <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <small class="text-secondary"><%= claimedCount %>/<%= capacity %> claimed</small>
                  <small class="text-secondary"><%= utilization %>%</small>
                </div>
                <div class="progress" style="height:4px;">
                  <div class="progress-bar" role="progressbar" style="width:<%= utilization %>%" aria-valuenow="<%= utilization %>" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
              </div>
            <% } %>
            
            <!-- Bottom buttons: Details link and Claim/Login button -->
						<div class="d-flex justify-content-between align-items-center mt-2">
							<a href="/events/<%= ev.id %>" class="btn btn-outline-light btn-sm">Details</a>
              
              <% if (soldOut) { %>
                <!-- Event is sold out -->
                <span class="badge bg-secondary text-uppercase">Sold out</span>
              <% } else if (currentUser && currentUser.role === 'student') { %>
                <!-- User is a student, show claim button -->
                <form action="/events/<%= ev.id %>/tickets/claim" method="POST" class="m-0">
								  <button class="btn btn-primary btn-sm" type="submit">Claim</button>
							  </form>
              <% } else if (currentUser) { %>
                <!-- User is logged in but not a student -->
                <span class="badge bg-secondary text-uppercase small">Students only</span>
              <% } else { %>
                <!-- User not logged in, show login link -->
                <a href="/login?next=<%= encodeURIComponent('/events/' + ev.id) %>" 
                   class="btn btn-primary btn-sm">Log in to claim</a>
              <% } %>
						</div>
					</div>
				</div>
			</div>
		<% }) %>
    
    <!-- Show message if no events found -->
		<% if(!events || !events.length){ %>
			<div class="col-12">
				<div class="alert alert-secondary text-center">
          <i class="fa-solid fa-calendar-xmark fa-2x mb-2"></i>
          <p class="mb-0">No events found. Try adjusting your filters.</p>
        </div>
			</div>
		<% } %>
	</div>
</main>

<!-- Footer -->
<%- include('../partials/footer') %>
</body>
</html>
