<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My Events</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%- include('../partials/nav', { active: 'my-events', injectStyles: true }) %>
</head>
<body>
<main class="container py-5">
  <h1 class="mb-4 text-center text-md-start">My Events</h1>

  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <div class="alert alert-danger">We couldn't load your tickets. Please try again later.</div>
  <% } %>

  <% if (!entries || !entries.length) { %>
    <div class="card bg-dark border-secondary shadow-sm">
      <div class="card-body text-center py-5">
        <h2 class="h5 mb-2">No tickets yet</h2>
        <p class="text-secondary mb-4">Find an event you like and claim a ticket to see it here.</p>
        <a href="/events" class="btn btn-primary btn-sm">Browse events</a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% entries.forEach(function(entry){ %>
        <%
          const statusLabel = entry.status ? entry.status.charAt(0).toUpperCase() + entry.status.slice(1) : 'Claimed';
        %>
        <div class="col-12 col-md-6">
          <div class="card h-100 bg-dark border-secondary shadow-sm">
            <div class="card-body d-flex flex-column">
              <h2 class="h5 mb-2"><%= entry.event.title %></h2>
              <p class="small text-secondary mb-2">
                <i class="fa-solid fa-calendar me-1"></i><%= entry.event.startsAtFormatted %>
              </p>
              <p class="small text-secondary mb-3">
                <i class="fa-solid fa-location-dot me-1"></i><%= entry.event.location %>
              </p>
              <p class="small flex-grow-1 text-secondary"><%= (entry.event.description || '').slice(0, 140) %>...</p>
              <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="badge bg-secondary text-uppercase"><%= statusLabel %></span>
                  <a href="/events/<%= entry.event.id %>" class="btn btn-outline-light btn-sm">Event details</a>
                </div>
                <div class="d-flex gap-2 mt-2">
                  <a href="/tickets/<%= entry.ticketId %>" class="btn btn-outline-light btn-sm w-100">View ticket</a>
                  <a href="/tickets/<%= entry.ticketId %>/qr?size=220" class="btn btn-primary btn-sm w-100" target="_blank" rel="noopener">Show QR</a>
                </div>
              </div>
              <p class="small text-secondary mt-2 mb-0">
                Claimed on <%= entry.claimedAt ? new Date(entry.claimedAt).toLocaleString() : '—' %>
              </p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
</body>
</html>
