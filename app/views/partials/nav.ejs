<% if (typeof injectStyles === 'undefined' || injectStyles) { %>
  <%- include('./styles') %>
<% } %>


<%
  const isLoggedIn = Boolean(currentUser);
  const role = isLoggedIn ? currentUser.role : null;
  const organizerStatus = isLoggedIn ? currentUser.organizerStatus : null;
  const isAdmin = role === 'admin';
  const isOrganizer = role === 'organizer';
  const isOrganizerApproved = isOrganizer && organizerStatus === 'approved';
  const showStudentMyEvents = role === 'student';
  const activeKey = typeof active === 'string' ? active : '';
  const dashboardHref = isOrganizerApproved
    ? `/organizers/${currentUser.id}/events`
    : '/profile';
%>

<nav class="navbar navbar-expand-lg mb-0" style="background:linear-gradient(90deg,var(--bg-dark,#111),var(--bg,#181818));border-bottom:1px solid var(--border,rgba(255,255,255,.1))">
  <div class="container position-relative">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <span class="d-inline-block rounded" style="width:34px;height:34px;background:linear-gradient(135deg,var(--bs-primary,#d8c16a),var(--bs-secondary,#b5a8ff));box-shadow:0 0 24px -4px rgba(0,0,0,.6)"></span>
      <span class="fw-bold"><%= typeof brand !== 'undefined' ? brand : 'Campus Events' %></span>
    </a>
    <% if (typeof crumbs !== 'undefined' && Array.isArray(crumbs) && crumbs.length) { %>
      <nav aria-label="breadcrumb" class="ms-3 d-none d-md-block small">
        <ol class="breadcrumb mb-0" style="--bs-breadcrumb-divider:'›';">
          <% crumbs.forEach(function(c, i){ %>
            <li class="breadcrumb-item <%= i === crumbs.length - 1 ? 'active' : '' %>">
              <% if (c.href && i !== crumbs.length - 1) { %>
                <a class="link-light text-decoration-none" href="<%= c.href %>"><%= c.label %></a>
              <% } else { %>
                <span class="text-secondary"><%= c.label %></span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </nav>
    <% } %>
    <button class="navbar-toggler text-light border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fas fa-bars"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
        <li class="nav-item">
          <a class="nav-link <%= activeKey === 'home' ? 'active fw-semibold' : '' %>" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= activeKey === 'events' ? 'active fw-semibold' : '' %>" href="/events">Events</a>
        </li>
        <% if (showStudentMyEvents) { %>
          <li class="nav-item">
            <a class="nav-link <%= activeKey === 'my-events' ? 'active fw-semibold' : '' %>" href="/my-events">My Events</a>
          </li>
        <% } %>
        <% if (isOrganizer) { %>
          <li class="nav-item">
            <a class="nav-link <%= activeKey && activeKey.startsWith('organizer') ? 'active fw-semibold' : '' %> <%= isOrganizerApproved ? '' : 'opacity-75 text-secondary' %>"
               href="<%= dashboardHref %>" <%= isOrganizerApproved ? '' : 'title="Pending approval"' %>>
              Dashboard
            </a>
          </li>
        <% } %>
        <% if (isAdmin) { %>
          <li class="nav-item">
            <a class="nav-link <%= activeKey === 'admin' ? 'active fw-semibold' : '' %>" href="/admin/dashboard">Admin</a>
          </li>
        <% } %>
      </ul>
      <div class="d-lg-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
        <% if (typeof navActions !== 'undefined' && navActions) { %>
          <%- navActions %>
        <% } else if (isLoggedIn) { %>
          <a class="btn btn-outline-light btn-sm px-3" href="/profile">
            <i class="fa-solid fa-user me-1"></i>My Profile
          </a>
          <form method="post" action="/logout" class="d-inline">
            <button type="submit" class="btn btn-primary btn-sm px-3">Logout</button>
          </form>

        <% } else { %>
          <a href="/login" class="btn btn-outline-primary btn-sm">Login</a>
          <a href="/register" class="btn btn-primary btn-sm">Sign Up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
